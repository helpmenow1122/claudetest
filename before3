<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Galaxy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0b0f;--yellow:#fee500;--blue:#3b6cff}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{background:var(--bg);font-family:"Noto Sans KR",sans-serif;display:flex;align-items:center;justify-content:center;overflow:hidden}
/* ===== Galaxy frame ===== */
.device{position:relative;width:min(400px,calc(100vw - 16px));height:min(860px,calc(100vh - 16px));height:min(860px,calc(100dvh - 16px));background:#111;border-radius:44px;padding:10px;box-shadow:0 0 0 2px #2b2b33,0 0 0 4px #0a0a0d,0 30px 80px rgba(0,0,0,.6)}
.device::before,.device::after{content:"";position:absolute;right:-5px;width:4px;border-radius:2px;background:#2b2b33}
.device::before{top:150px;height:50px}.device::after{top:230px;height:90px}
.screen{position:relative;width:100%;height:100%;background:#fff;border-radius:34px;overflow:hidden;display:flex;flex-direction:column}
.cam{position:absolute;top:11px;left:50%;transform:translateX(-50%);width:13px;height:13px;border-radius:50%;background:#000;z-index:100;box-shadow:0 0 0 2px #1a1a1f}
button,input,textarea{font-family:inherit}
.clamp{display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}
.more{display:none;font-size:13px;color:#999;margin:-2px 0 8px}
.ptitle{font-weight:700;font-size:16px;margin-top:8px}
.ptitle+.txt{margin-top:4px!important}
.dbg{position:absolute;inset:0;background:rgba(0,0,0,.4);display:none;z-index:50}
.drawer{position:absolute;top:0;right:0;bottom:0;width:68%;background:#fff;transform:translateX(100%);transition:transform .25s;z-index:51;padding-top:8px}
.drawer.on{transform:none}
.drawer .dh{padding:14px 20px;font-weight:700;font-size:17px;border-bottom:1px solid #eee}
.drawer .it{padding:15px 20px;font-size:15px;cursor:pointer}
.drawer .it.on{color:#3b6cff;font-weight:700;background:#f0f4ff}
.status{height:34px;flex:none;display:flex;justify-content:space-between;align-items:center;padding:6px 26px 0;font-size:13px;font-weight:600;z-index:90;color:#111}
.status.light{color:#fff}
.status .r{display:flex;gap:6px;align-items:center;font-size:11px}
.bat{display:inline-block;width:20px;height:10px;border:1.5px solid currentColor;border-radius:3px;position:relative}
.bat::after{content:"";position:absolute;inset:1px;width:75%;background:currentColor;border-radius:1px}
.navbar{height:30px;flex:none;display:flex;justify-content:center;align-items:center;gap:60px;background:inherit}
.nav{position:absolute;bottom:0;left:0;right:0;height:44px;display:flex;justify-content:center;align-items:center;gap:40px;z-index:100;background:#fff;color:#222}
.nav.dark{background:transparent;color:#fff}
.nav button{background:none;border:0;width:56px;height:44px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:inherit}
.nav i{display:block}
.nav .rc{width:2px;height:16px;background:currentColor;box-shadow:7px 0 0 currentColor,-7px 0 0 currentColor}
.nav .hm{width:16px;height:16px;border:2px solid currentColor;border-radius:50%}
.nav .bk{width:11px;height:11px;border-left:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);margin-left:4px}
.view{position:absolute;inset:0;display:none;flex-direction:column;padding-bottom:44px}
.view.on{display:flex}
.body{flex:1;overflow-y:auto}
/* ===== Home ===== */
#home{background:linear-gradient(160deg,#1c2b5a,#5b3a8c 55%,#c0577a)}
.clock{color:#fff;text-align:center;margin-top:50px}
.clock .t{font-size:64px;font-weight:300}.clock .d{font-size:15px;opacity:.85;margin-top:4px}
.apps{display:grid;grid-template-columns:repeat(4,1fr);gap:22px 8px;padding:30px 22px;margin-top:0}
.app{display:flex;flex-direction:column;align-items:center;gap:6px;color:#fff;font-size:12px;cursor:pointer}
.ico{width:58px;height:58px;border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:28px;box-shadow:0 4px 10px rgba(0,0,0,.25)}
.dock{height:90px}
/* ===== Community ===== */
#comm{background:#f4f5f7}
.hdr{height:52px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:#fff;border-bottom:1px solid #eee;font-weight:700;font-size:18px}
.hdr button{background:none;border:0;font-size:20px;cursor:pointer;color:#222}
.post{background:#fff;margin-bottom:8px;padding:14px 16px;cursor:pointer}
.nick{font-weight:700;font-size:14px;color:#2a2a2a}.time{font-size:11px;color:#999;margin-left:6px;font-weight:400}
.post .txt{margin:8px 0;font-size:15px;line-height:1.5;white-space:pre-wrap;word-break:break-all}
.meta{display:flex;gap:14px;font-size:13px;color:#777}
.lk{background:none;border:0;cursor:pointer;font-size:13px;color:#777;display:inline-flex;align-items:center;gap:3px}
.lk.on{color:#ff3b5c;font-weight:700}
.cm{padding:12px 16px;background:#fff;border-bottom:1px solid #f0f0f0}
.cm.re{padding-left:40px;background:#fafafa}
.cm .txt{font-size:14px;margin:5px 0;line-height:1.45;white-space:pre-wrap;word-break:break-all}
.cm .act{display:flex;gap:12px}
.inp{flex:none;display:flex;gap:8px;padding:8px 12px;background:#fff;border-top:1px solid #eee;align-items:center}
.inp input,.inp textarea{flex:1;border:0;background:#f0f1f3;border-radius:18px;padding:10px 14px;font:inherit;font-size:14px;outline:none;resize:none}
.inp button{border:0;background:var(--blue);color:#fff;border-radius:16px;padding:9px 14px;font-weight:700;cursor:pointer;font-size:13px}
.replyto{font-size:12px;color:var(--blue);padding:6px 16px;background:#eef2ff;display:none;justify-content:space-between}
.empty{text-align:center;color:#aaa;padding:60px 0;font-size:14px}
.fab{position:absolute;right:18px;bottom:60px;width:52px;height:52px;border-radius:50%;background:var(--blue);color:#fff;font-size:26px;border:0;box-shadow:0 4px 12px rgba(59,108,255,.5);cursor:pointer}
.write{padding:14px;background:#fff;flex:1;display:flex;flex-direction:column;gap:10px}
.write textarea{flex:1;border:0;outline:none;font:inherit;font-size:16px;resize:none}
.write .note{font-size:12px;color:#999}
/* ===== 헌톡 ===== */
#talk{background:#fff}
.tabs{flex:none;display:flex;border-top:1px solid #eee;background:#fff;padding-bottom:4px}
.tabs div{flex:1;text-align:center;padding:10px 0;font-size:12px;color:#aaa;cursor:pointer}
.tabs div.on{color:#222;font-weight:700}.tabs div span{display:block;font-size:20px}
.ppl{display:flex;align-items:center;gap:12px;padding:10px 16px;cursor:pointer}
.av{width:46px;height:46px;border-radius:17px;background:#ddd;display:flex;align-items:center;justify-content:center;font-size:22px;flex:none}
.ppl .n{font-size:15px;font-weight:600}.ppl .s{font-size:12.5px;color:#888;margin-top:2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;max-width:220px}
.ppl .e{margin-left:auto;text-align:right;font-size:11px;color:#aaa}
.badge{display:inline-block;background:#ff4b3a;color:#fff;border-radius:10px;font-size:11px;padding:1px 7px;margin-top:4px}
.sec{font-size:12px;color:#999;padding:10px 16px 4px}
#room{background:#b2c7da}
.rh{background:#b2c7da;height:52px;flex:none;display:flex;align-items:center;gap:10px;padding:0 14px;font-weight:700;font-size:17px}
.rh button{background:none;border:0;font-size:22px;cursor:pointer}
.msgs{flex:1;overflow-y:auto;padding:8px 12px;display:flex;flex-direction:column;gap:8px}
.day{align-self:center;background:rgba(0,0,0,.18);color:#fff;font-size:11px;padding:4px 12px;border-radius:12px;margin:6px 0}
.m{display:flex;gap:8px;align-items:flex-end;max-width:82%}
.m.me{align-self:flex-end;flex-direction:row-reverse}
.m .who{font-size:12px;color:#333;margin-bottom:3px}
.bub{background:#fff;padding:8px 11px;border-radius:4px 14px 14px 14px;font-size:14px;line-height:1.4;white-space:pre-wrap;word-break:break-all}
.me .bub{background:var(--yellow);border-radius:14px 4px 14px 14px}
.m .tm{font-size:10px;color:#506070;flex:none}
.m .av{width:38px;height:38px;border-radius:14px;font-size:18px;align-self:flex-start}
.rin{flex:none;display:flex;gap:8px;padding:8px 10px 10px;background:#fff;align-items:center}
.rin input{flex:1;border:0;background:#f2f2f2;border-radius:18px;padding:10px 14px;font:inherit;font-size:14px;outline:none}
.rin button{border:0;background:var(--yellow);border-radius:16px;padding:9px 13px;font-weight:700;cursor:pointer}
.toast{position:absolute;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.8);color:#fff;font-size:13px;padding:8px 16px;border-radius:18px;opacity:0;transition:.3s;pointer-events:none;z-index:200}
.toast.on{opacity:1}
.btabs{flex:none;display:flex;background:#fff;border-bottom:1px solid #eee;overflow-x:auto}
.btabs div{flex:none;padding:11px 15px;font-size:14px;color:#888;cursor:pointer;white-space:nowrap}
.btabs div.on{color:#3b6cff;font-weight:700;border-bottom:2px solid #3b6cff}
.igh{font-style:italic;font-weight:700;font-size:24px}
.stories{display:flex;gap:12px;padding:10px 12px;overflow-x:auto;border-bottom:1px solid #eee}
.story{text-align:center;font-size:11px;flex:none;width:62px}
.story .rg{width:58px;height:58px;border-radius:50%;padding:3px;background:linear-gradient(45deg,#feda75,#d62976,#4f5bd5);margin-bottom:3px}
.story .rg div{width:100%;height:100%;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;border:2px solid #fff}
.igp .top{display:flex;align-items:center;gap:8px;padding:10px 12px;font-weight:600;font-size:14px}
.igp .acts{padding:8px 12px 4px}.igp .cap{padding:0 12px 14px;font-size:13.5px;line-height:1.45}
.pic{width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:90px;background-size:cover;background-position:center}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}.grid3 .pic{font-size:36px;cursor:pointer}
.sms .bub{background:#e9ecef}.sms .me .bub{background:var(--blue);color:#fff}
.sms .rh,.sms .rin{background:#fff}.sms .rin button{background:var(--blue);color:#fff}.sms .tm{color:#999}
.ytlogo{display:flex;align-items:center;gap:4px;font-weight:700;font-size:18px;letter-spacing:-.5px}
.ytlogo i{background:#f00;color:#fff;border-radius:6px;font-style:normal;font-size:10px;padding:3px 7px}
.chips{display:flex;gap:8px;padding:8px 12px;overflow-x:auto;flex:none}
.chips span{flex:none;background:#f0f0f0;border-radius:8px;padding:6px 12px;font-size:13px}.chips span:first-child{background:#111;color:#fff}
.yv{margin-bottom:14px;cursor:pointer}
.thumb{position:relative;width:100%;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;font-size:64px;background-size:cover;background-position:center}
.dur{position:absolute;right:8px;bottom:8px;background:rgba(0,0,0,.8);color:#fff;font-size:12px;padding:1px 5px;border-radius:4px;font-family:inherit}
.play{position:absolute;width:56px;height:56px;border-radius:50%;background:rgba(0,0,0,.6);color:#fff;font-size:22px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.yi{display:flex;gap:10px;padding:10px 12px}
.yi .av{width:36px;height:36px;border-radius:50%;font-size:18px}
.yi .tt{font-weight:500;font-size:14.5px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.yi .sub{font-size:12px;color:#606060;margin-top:3px}
.ywt{padding:10px 14px 4px;font-weight:700;font-size:17px;line-height:1.35}
.ywm{padding:0 14px;font-size:12px;color:#606060}
.ych{display:flex;align-items:center;gap:10px;padding:12px 14px}
.ych b{font-size:14px}
.sbtn{margin-left:auto;border:0;border-radius:18px;background:#111;color:#fff;padding:8px 14px;font-size:13px;font-weight:500;cursor:pointer}
.sbtn.on{background:#f0f0f0;color:#111}
.ywd{margin:6px 14px 20px;background:#f2f2f2;border-radius:12px;padding:10px 12px;font-size:13px;line-height:1.5;white-space:pre-wrap}
.ico{overflow:hidden;box-shadow:0 3px 8px rgba(0,0,0,.3)}.ico svg{width:100%;height:100%;display:block}
.etabs div.on{color:#c62917}.etabs div:not(.on) span{filter:grayscale(1);opacity:.5}
.etfab{background:#c62917;box-shadow:0 4px 12px rgba(198,41,23,.45);font-size:22px}
.bi{padding:14px 18px;border-bottom:1px solid #f1f1f1;cursor:pointer}
.bn{font-size:15px;font-weight:700}.bp{font-size:12.5px;color:#888;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bi.off .bn{color:#bbb;font-weight:400}
.et{padding:14px 16px;border-bottom:1px solid #eee;cursor:pointer}
.et .ptitle{margin:0 0 4px}.et .txt{font-size:14px;line-height:1.45;color:#444;white-space:pre-wrap;word-break:break-all;margin:0}
.et .more{margin:2px 0 0}
.etm{display:flex;gap:8px;font-size:12px;color:#999;margin-top:8px;align-items:center}
.etm .r{margin-left:auto;display:flex;gap:10px}
.etm b{display:inline-flex;align-items:center;gap:3px;font-weight:400}
.up{color:#c62917}.cc{color:#1ba5a5}
.dp{padding:14px 16px;border-bottom:1px solid #eee}
.dau{display:flex;gap:10px;align-items:center}
.pf{width:36px;height:36px;border-radius:50%;background:#eee;display:flex;align-items:center;justify-content:center;font-size:18px;flex:none}
.pf.s{width:24px;height:24px;font-size:12px}
.dn{font-weight:700;font-size:14px}.dn small,.ech small{color:#999;font-weight:400;margin-left:4px}.dt{font-size:11.5px;color:#999;margin-top:1px}
.dtx{font-size:15px;line-height:1.6;white-space:pre-wrap;word-break:break-all}
.dbt{display:flex;gap:8px;margin-top:12px}
.dbt button{flex:1;border:1px solid #ddd;background:#fff;border-radius:6px;padding:8px;font-size:13px;color:#555;display:flex;justify-content:center;align-items:center;gap:4px;cursor:pointer;font-family:inherit}
.dbt button.on{color:#c62917;border-color:#c62917}
.ec{padding:12px 16px;border-bottom:1px solid #f1f1f1}.ec.re{background:#f6f6f6;padding-left:40px}
.ech{display:flex;align-items:center;gap:8px;font-size:13px}.ech b{font-weight:700}
.ech small.op{color:#c62917;font-weight:700}
.ea{margin-left:auto;display:flex;gap:10px}.ea button{background:none;border:0;color:#999;cursor:pointer;display:flex}.ea button.on{color:#c62917}
.ect{font-size:14px;line-height:1.5;margin:6px 0 4px;white-space:pre-wrap;word-break:break-all}
.ecm{font-size:11.5px;color:#999;display:flex;gap:8px;align-items:center}
.replyto{background:#fdecea;color:#c62917}
.etinp button{background:none;color:#c62917;font-size:20px;padding:4px 8px}
</style>
</head>
