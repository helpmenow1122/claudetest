    ${p.title?`<div class="ptitle" style="font-size:17px;margin:12px 0 6px">${esc(p.title)}</div>`:'<div style="height:10px"></div>'}
    <div class="dtx">${esc(p.text)}</div>
    <div class="etm" style="margin-top:12px"><b class="up">${IC_UP} ${p.likes}</b><b class="cc">${IC_CM} ${countC(p)}</b></div>
    <div class="dbt"><button class="${on?'on':''}" onclick="toggleLike('${p.id}')">${IC_UP} 공감</button><button onclick="toast('스크랩은 사용할 수 없습니다')">⭐ 스크랩</button></div></div>`;
  if(!p.comments.length) h+='<div class="empty" style="padding:30px 0">첫 댓글을 남겨보세요</div>';
  p.comments.forEach(c=>{ h+=cmHtml(c,false); (c.replies||[]).forEach(r=>h+=cmHtml(r,true)); });
  const b=$("dbody"), st=b.scrollTop; b.innerHTML=h; b.scrollTop=st;
}
function cmHtml(c,isRe){
  const mine=S.myNick[curPost]===c.nick, on=S.liked[c.id];
  return `<div class="ec ${isRe?'re':''}"><div class="ech"><span class="pf s">👤</span><b>${esc(c.nick)}${isOP(c.nick)?'<small class="op">글쓴이</small>':''}${mine?'<small>(나)</small>':''}</b>
    <span class="ea">${isRe?'':`<button onclick="setReply('${c.id}')">${IC_CM}</button>`}<button class="${on?'on':''}" onclick="toggleLike('${c.id}')">${IC_UP}</button></span></div>
    <div class="ect">${esc(c.text)}</div>
    <div class="ecm">${esc(c.time)}${c.likes?` <b class="up">${IC_UP} ${c.likes}</b>`:''}</div></div>`;
}
function setReply(cid){
  replyTarget=cid; const box=$("rto");
  if(cid){ const c=findItem(cid); $("rtxt").textContent=c.nick+" 님에게 답글 작성 중"; box.style.display="flex"; $("cin").focus(); }
  else box.style.display="none";
}
/* 한 글 안에서 내 닉네임은 항상 같고, 다른 사람과 겹치지 않음 */
function nickFor(p){
  if(S.myNick[p.id]) return S.myNick[p.id];
  const used=new Set([p.nick]);
  p.comments.forEach(c=>{ used.add(c.nick); (c.replies||[]).forEach(r=>used.add(r.nick)); });
  let n; do{ n=randNick(); }while(used.has(n));
  return S.myNick[p.id]=n;
}
function isOP(n){ const p=S.posts.find(x=>x.id===curPost); return p&&p.nick===n; }
function submitComment(){
  const t=$("cin").value.trim(); if(!t) return;
  const p=S.posts.find(x=>x.id===curPost);
  const item={ id:uid(), nick:nickFor(p), text:t, likes:0, time:nowLabel() };
  if(replyTarget){ const c=p.comments.find(x=>x.id===replyTarget); (c.replies=c.replies||[]).push(item); }
  else { item.replies=[]; p.comments.push(item); }
  $("cin").value=""; setReply(null); save(); renderDetail();
  const b=$("dbody"); b.scrollTop=b.scrollHeight;
}

/* ---- 헌톡 ---- */
let curTab="f", curRoom=null;
function talkTab(t){
  curTab=t; $("tab-f").classList.toggle("on",t==="f"); $("tab-c").classList.toggle("on",t==="c");
  $("ttitle").textContent=t==="f"?"친구":"채팅";
  let h="";
  if(t==="f"){
    h+=`<div class="ppl"><div class="av">${ME.emoji}</div><div><div class="n">${esc(ME.name)}</div></div></div><div class="sec">친구 ${S.chats.filter(c=>!c.name.includes("(")).length}</div>`;
    S.chats.filter(c=>!c.name.includes("(")).forEach(c=>{
      h+=`<div class="ppl" onclick="openRoom('${c.id}')"><div class="av">${c.emoji}</div><div><div class="n">${esc(c.name)}</div><div class="s">${esc(c.status)}</div></div></div>`;
    });
  } else {
    S.chats.forEach(c=>{
      const last=c.msgs[c.msgs.length-1]||{text:"",time:""};
      h+=`<div class="ppl" onclick="openRoom('${c.id}')"><div class="av">${c.emoji}</div>
        <div><div class="n">${esc(c.name)}</div><div class="s">${esc(last.text)}</div></div>
        <div class="e">${esc(last.time)}<br>${c.unread?`<span class="badge">${c.unread}</span>`:""}</div></div>`;
    });
  }
  $("tbody").innerHTML=h;
}
function openRoom(id){
  curRoom=S.chats.find(c=>c.id===id); curRoom.unread=0; save();
  $("rname").textContent=curRoom.name; show("room"); renderMsgs();
}
function closeRoom(){ show("talk"); talkTab(curTab); }
function renderMsgs(){
  let h='<div class="day">오늘</div>';
  curRoom.msgs.forEach(m=>{
    const me=m.from==="me";
    h+=`<div class="m ${me?'me':''}">${me?'':`<div class="av">${curRoom.emoji}</div>`}
      <div>${!me&&m.who?`<div class="who">${esc(m.who)}</div>`:''}<div class="bub">${esc(m.text)}</div></div>
      <span class="tm">${esc(m.time)}</span></div>`;
  });
  const b=$("msgs"); b.innerHTML=h; b.scrollTop=b.scrollHeight;
}
function sendMsg(){
  const i=$("min"), t=i.value.trim(); if(!t) return;
  const d=new Date(), h=d.getHours();
  curRoom.msgs.push({ from:"me", text:t, time:(h<12?"오전 ":"오후 ")+(h%12||12)+":"+String(d.getMinutes()).padStart(2,"0") });
  i.value=""; save(); renderMsgs();
}
/* ---- 공용 ---- */
function tm(){ const d=new Date(),h=d.getHours(); return (h<12?"오전 ":"오후 ")+(h%12||12)+":"+String(d.getMinutes()).padStart(2,"0"); }
const pic=o=>o.img?`background-image:url('${o.img}')`:`background:${o.bg}`;

/* ---- 인스타그램 ---- */
function renderInsta(){
  let h='<div class="stories">'+INSTA.map(p=>`<div class="story"><div class="rg"><div>${p.emoji}</div></div>${esc(p.user.slice(0,9))}</div>`).join("")+'</div>';
  h+=INSTA.map(p=>{ const on=S.liked[p.id]; return `<div class="igp">
    <div class="top"><div class="av" style="width:32px;height:32px;border-radius:50%;font-size:16px">${p.emoji}</div>${esc(p.user)}</div>
    <div class="pic" style="${pic(p)}">${p.img?'':p.emoji}</div>
    <div class="acts"><button class="lk ${on?'on':''}" style="font-size:22px" onclick="igLike('${p.id}')">${on?'❤️':'🤍'}</button> <span style="font-weight:600;font-size:13px">좋아요 ${p.likes+(on?1:0)}개</span></div>
    <div class="cap"><b>${esc(p.user)}</b> ${esc(p.caption)}${p.comments.map(c=>`<div style="color:#555"><b>${esc(c.user)}</b> ${esc(c.text)}</div>`).join("")}<div class="time" style="margin:4px 0 0">${esc(p.time)}</div></div></div>`; }).join("");
  $("igbody").innerHTML=h;
}
function igLike(id){ if(S.liked[id]) delete S.liked[id]; else S.liked[id]=1; save(); const b=$("igbody"),y=b.scrollTop; renderInsta(); b.scrollTop=y; }

/* ---- 유튜브 ---- */
function renderYt(){
  $("ytbody").innerHTML=YOUTUBE.map(v=>`<div class="yv" onclick="openVideo('${v.id}')">
    <div class="thumb" style="${pic(v)}">${v.img?'':v.emoji}<span class="dur">${esc(v.duration)}</span></div>
    <div class="yi"><div class="av" style="background:#ddd;display:flex;align-items:center;justify-content:center;flex:none">${v.emoji}</div>
    <div><div class="tt">${esc(v.title)}</div><div class="sub">${esc(v.channel)} · ${esc(v.views)} · ${esc(v.time)}</div></div></div></div>`).join("");
}
let curVid=null;
function openVideo(id){
  curVid=YOUTUBE.find(x=>x.id===id);
  $("ytplayer").innerHTML=curVid.video
    ? `<video src="${curVid.video}" controls autoplay playsinline style="width:100%;aspect-ratio:16/9;background:#000;display:block"></video>`
    : `<div class="thumb" style="${pic(curVid)}">${curVid.img?'':curVid.emoji}<div class="play" onclick="toast('동영상을 재생할 수 없습니다')">▶</div></div>`;
  show("ytw"); renderYtw();
}
function renderYtw(){
  const v=curVid, on=S.liked[v.id], sub=S.liked["sub:"+v.channel];
  $("ytwbody").innerHTML=`<div class="ywt">${esc(v.title)}</div><div class="ywm">${esc(v.views)} · ${esc(v.time)}</div>
   <div class="ych"><div class="av" style="width:36px;height:36px;border-radius:50%;font-size:18px">${v.emoji}</div><b>${esc(v.channel)}</b>
   <button class="sbtn ${sub?'on':''}" onclick="ytSub()">${sub?'구독중':'구독'}</button></div>
   <div style="padding:0 14px 8px"><button class="lk ${on?'on':''}" style="font-size:15px;background:#f2f2f2;border-radius:18px;padding:8px 14px" onclick="ytLike()">${on?'👍':'👍🏻'} ${v.likes+(on?1:0)}</button></div>
   <div class="ywd">${esc(v.desc)}</div>`;
}
function ytLike(){ const k=curVid.id; if(S.liked[k]) delete S.liked[k]; else S.liked[k]=1; save(); renderYtw(); }
function ytSub(){ const k="sub:"+curVid.channel; if(S.liked[k]) delete S.liked[k]; else S.liked[k]=1; save(); renderYtw(); }

/* ---- 갤러리 ---- */
function renderGallery(){ $("gbody").innerHTML=GALLERY.map(g=>`<div class="pic" style="${pic(g)}" onclick="openPhoto('${g.id}')">${g.img?'':g.emoji}</div>`).join(""); }
function openPhoto(id){
  const g=GALLERY.find(x=>x.id===id); $("gvt").textContent=g.title+" · "+g.date;
  $("gvbody").innerHTML=`<div class="pic" style="${pic(g)};font-size:140px">${g.img?'':g.emoji}</div>`; show("galview");
}

/* ---- 메시지(문자) ---- */
let curSms=null;
function renderSmsList(){
  $("slbody").innerHTML=S.sms.map(c=>{ const l=c.msgs[c.msgs.length-1]||{text:"",time:""};
    return `<div class="ppl" onclick="openSms('${c.id}')"><div class="av">${c.emoji}</div><div><div class="n">${esc(c.name)}</div><div class="s">${esc(l.text)}</div></div><div class="e">${esc(l.time)}</div></div>`; }).join("");
}
function openSms(id){ curSms=S.sms.find(c=>c.id===id); $("stname").textContent=curSms.name; show("smst"); renderSmsMsgs(); }
function renderSmsMsgs(){
  let h='<div class="day" style="background:#bbb">오늘</div>';
  curSms.msgs.forEach(m=>{ const me=m.from==="me";
    h+=`<div class="m ${me?'me':''}"><div class="bub">${esc(m.text)}</div><span class="tm">${esc(m.time)}</span></div>`; });
  const b=$("stmsgs"); b.innerHTML=h; b.scrollTop=b.scrollHeight;
}
function sendSms(){
  const i=$("sin"), t=i.value.trim(); if(!t) return;
  curSms.msgs.push({ from:"me", text:t, time:tm() }); i.value=""; save(); renderSmsMsgs();
}

/* ---- 링크 ---- */
function openLink(k){ window.open(LINKS[k],"_blank","noopener"); }

/* ---- 시작 화면: 커뮤니티 > 후기 게시판 ---- */
show("comm"); renderFeed();
</script>
